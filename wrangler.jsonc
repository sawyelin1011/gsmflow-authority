/**
 * GSMFlow License Authority Configuration
 * 
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gsmflow-authority",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-05",
	"observability": {
		"enabled": true
	},
	
	/**
	 * D1 Database Binding
	 * Stores tenant registry, license history, and audit logs
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gsmflow-authority",
			"database_id": "44c9c419-8c5e-4f4b-be44-4a7d6b464b8e"
		}
	],
	
	/**
	 * KV Namespace Binding
	 * Stores revocation list and public key
	 */
	"kv_namespaces": [
		{
			"binding": "REVOCATIONS",
			"id": "700565ede6044acaa8c8df092be9d77e"
		}
	]
	
	/**
	 * Secrets (set via wrangler secret put)
	 * - LICENSE_PRIVATE_KEY: Base64-encoded ED25519 private key
	 * - HMAC_SECRET: HMAC-SHA256 secret for service authentication
	 */
}