# GSMFlow License Authority Configuration

# D1 Database
D1_DATABASE_ID=your-database-id

# KV Cache
KV_NAMESPACE_ID=your-kv-id

# Authentication
AUTH_SHARED_SECRET=your-hmac-secret-here

# ED25519 Keys (generate with: openssl genpkey -algorithm ED25519)
ED25519_PRIVATE_KEY=base64-encoded-private-key
ED25519_PUBLIC_KEY=base64-encoded-public-key

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100